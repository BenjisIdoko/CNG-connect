# ====================================================================
# CNG-Connect environment variables.
# Copy to .env.local for local dev, or set in your Vercel project's
# Environment Variables (Production/Preview/Development).
# ====================================================================

# --- Supabase backend (required for a shared, multi-driver backend) ---
# Without these, the app silently falls back to per-device localStorage:
# no driver ever sees another driver's reports, comments, or posts.
# Create a free project at https://supabase.com, then:
#   1. Run supabase/schema.sql in the SQL Editor.
#   2. Copy the Project URL and anon/public key from Settings > API.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# Service-role key (Settings > API > service_role). SERVER-ONLY — never
# prefix this with VITE_ or it will be bundled into the client. Required
# for the OTP session store (api/otp/store.ts) to persist reliably across
# serverless invocations; without it, OTP falls back to in-memory storage
# that is NOT shared between Vercel's serverless instances and will
# intermittently fail verification.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# --- Email verification (OTP) — free path, no SMS costs ---
# Create a free account at https://resend.com (100 emails/day, 3,000/month
# free). Verify a domain you control for reliable delivery to any address;
# without a verified domain, Resend's shared sender has tighter limits.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
# Must be on a domain verified in your Resend account, e.g. "CNG-Connect <no-reply@yourdomain.com>".
RESEND_FROM_ADDRESS="CNG-Connect <onboarding@resend.dev>"

# ALLOW_DEV_OTP: set to "true" ONLY in local/.env.local to bypass real email
# sending during development (accepts code 123456). This is hard-disabled
# whenever VERCEL_ENV=production regardless of this flag — never rely on it
# for a live deployment, and never set it in a Vercel Production env var.
ALLOW_DEV_OTP="false"

# --- AI Assistant (optional) ---
# Required for the in-app AI Assistant (api/chat.ts). Without it, that
# feature returns a clean error instead of a response.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (self-referential links, etc).
APP_URL="MY_APP_URL"
