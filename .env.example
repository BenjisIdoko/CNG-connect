# ====================================================================
# CNG-Connect environment variables.
# Copy to .env.local for local dev, or set in your Vercel project's
# Environment Variables (Production/Preview/Development).
# ====================================================================

# --- Supabase backend + auth (required) ---
# Without these, the app falls back to per-device localStorage: no driver
# ever sees another driver's reports/comments/posts, and sign-in doesn't
# work at all (auth is real Supabase Auth now, not a custom system).
# Create a free project at https://supabase.com, then:
#   1. Run supabase/schema.sql in the SQL Editor.
#   2. Copy the Project URL and anon/public key from Settings > API.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# Service-role key (Settings > API > service_role). SERVER-ONLY — never
# prefix this with VITE_ or it will be bundled into the client. Not used by
# the app's own serverless functions except api/notify-gas-post.ts (push
# alerts, below), which reads it on the server. Keep it out of client code.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# --- Email sign-in (Supabase Auth email OTP) — free, no SMS costs ---
# Sign-in/sign-up is a single email + code flow (no password), handled
# entirely by Supabase Auth (supabase.auth.signInWithOtp / verifyOtp) —
# there is no app-level OTP env var to set. Four things need configuring
# in the Supabase dashboard for it to actually deliver as a code:
#
#   1. Authentication > Providers > Email — enable the Email provider, and
#      TURN OFF "Confirm email". With OTP the code IS the proof of email
#      ownership; leaving "Confirm email" on inserts a separate
#      confirmation-link step, so a NEW user gets a link first and the
#      code screen has nothing to type (they have to re-enter their email
#      to get a second email with the actual code).
#   2. Authentication > Emails > SMTP Settings — enable Custom SMTP so you
#      aren't limited to Supabase's shared sender (a handful of emails/hour,
#      "for testing" per their own docs). Point it at Resend's SMTP relay:
#        Host: smtp.resend.com   Port: 465 (or 587)
#        Username: resend
#        Password: your Resend API key (https://resend.com — free tier)
#        Sender email: an address on a verified Resend domain, e.g.
#                      no-reply@cngconnect.com.ng
#   3. Authentication > Emails > Email Templates > "Magic Link" — by
#      default this links to a URL. Edit it to reference {{ .Token }}
#      instead so the email contains the numeric code the sign-in screen
#      asks for. Without this edit, drivers get a link with nothing to
#      type in. (The code length is a project setting, 6-10 digits — the
#      UI does not assume a fixed length.)
#   4. Authentication > Rate Limits > "Emails per hour" — raise it off the
#      default (2) if you'll be testing with several addresses.

# --- AI Assistant (optional) ---
# Required for the in-app AI Assistant (api/chat.ts). Without it, that
# feature returns a clean error instead of a response.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Station manager invite email (optional, set in Vercel, not in the browser) ---
# api/invite-manager.ts emails a station manager when the admin invites them. Without these two the
# invite is still saved and the admin screen says "the email did not go out".
#   RESEND_API_KEY   the same Resend API key used as the Supabase SMTP password above
#   INVITE_FROM_EMAIL  a sender on a verified Resend domain, e.g. CNG-Connect <no-reply@cngconnect.com.ng>
#   SITE_URL         optional, defaults to https://cngconnect.com.ng (the link in the email)
RESEND_API_KEY=""
INVITE_FROM_EMAIL=""

# --- Push alerts for community manager posts (set in Vercel, not in the browser) ---
# api/notify-gas-post.ts sends a push notification to opted-in drivers when a community manager posts
# "Gas available" / "Gas not available". Create the keys once with:  npx web-push generate-vapid-keys
# Without these the function answers 503, nothing is sent, and the app's alerts toggle falls back to
# in-app alerts only. Also needs SUPABASE_SERVICE_ROLE_KEY above and supabase/push-subscriptions.sql.
#   VAPID_PUBLIC_KEY       the public key
#   VITE_VAPID_PUBLIC_KEY  the SAME public key again, so the app can register phones (public, safe in the bundle)
#   VAPID_PRIVATE_KEY      the private key (secret, server only)
#   VAPID_SUBJECT          mailto:you@example.com, a contact address push services may use
VAPID_PUBLIC_KEY=""
VITE_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# --- Admin pin editor map (optional) ---
# Only the ?admin=1 station-pin editor uses Google Maps; the driver app
# stays on free OSM/Leaflet tiles. Needs the "Maps JavaScript API" enabled
# on the key (the Places-enrichment key works once you add that API) and an
# HTTP-referrer restriction to your domain(s). VITE_ prefix = shipped to the
# browser, so keep it referrer-restricted. Without it the editor still works
# via the paste-coordinates box, just no visible map.
VITE_GOOGLE_MAPS_API_KEY="MY_BROWSER_MAPS_KEY"

# APP_URL: The URL where this app is hosted (self-referential links, etc).
APP_URL="MY_APP_URL"
